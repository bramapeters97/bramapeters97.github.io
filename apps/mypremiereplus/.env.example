# Local development only; no source-project credentials are required.
PORT=8787
HOST=127.0.0.1
BASE_PATH=/mypremiereplus
# DATA_DIRECTORY=.local
# Leave DATA_DIRECTORY unset to use the bundled demo-data/mypremiereplus.db.
# If that editable file is missing, local demo setup copies pristine demo-data/seed.db once.
# DATA_DIRECTORY chooses a separate private runtime database and hides the demo account directory.
# DB_PATH=./path/to/your-own.sqlite
# Never enable demo authentication on a public production service.
DEMO_MODE=true
# Production integration placeholders, server-side only. No live resources are provisioned.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_HOST=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY=
AI_IMAGE_PROVIDER=demo
TRANSCRIPTION_PROVIDER=manual
