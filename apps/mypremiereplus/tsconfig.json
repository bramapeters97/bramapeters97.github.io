{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@mypremiere/types": ["./src/lib/types/index.ts"],
      "@mypremiere/shared": ["./src/lib/shared/index.ts"],
      "@mypremiere/navigation": ["./src/lib/navigation/index.ts"],
      "@mypremiere/catalog": ["./src/viewer/catalogue.ts"]
    }
  },
  "include": ["src", "server", "vite.config.ts"],
  "exclude": ["**/*.test.ts"]
}
